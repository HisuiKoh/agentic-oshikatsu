{
	"name": "agentic-oshikatsu",
	"version": "0.1.0",
	"description": "推し活 × AI のエージェンティックツール",
	"type": "module",
	"bin": {
		"oshi": "./dist/bin/oshi.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsx --watch bin/oshi.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/infrastructure/db/migrate.ts"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/HisuiKoh/agentic-oshikatsu.git"
	},
	"homepage": "https://github.com/HisuiKoh/agentic-oshikatsu",
	"bugs": {
		"url": "https://github.com/HisuiKoh/agentic-oshikatsu/issues"
	},
	"keywords": [
		"oshikatsu",
		"ai",
		"cli",
		"agent",
		"fandom",
		"typescript"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"license": "Apache-2.0",
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.74.0",
		"@clack/prompts": "^1.0.1",
		"@inkjs/ui": "^2.0.0",
		"better-sqlite3": "^12.6.2",
		"drizzle-orm": "^0.45.1",
		"fast-xml-parser": "^5.3.6",
		"ink": "^6.7.0",
		"nanoid": "^3.3.11",
		"react": "^19.2.4",
		"yaml": "^2.8.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.15",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.2.3",
		"@types/react": "^19.2.14",
		"drizzle-kit": "^0.31.9",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
